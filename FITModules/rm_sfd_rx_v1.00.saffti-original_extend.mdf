<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00.saffti-original</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="RM_SFD_CFG_REGION_SIZE_BYTES" display="Default data flash region size in bytes." default="32768" type="text"/>
        <property id="RM_SFD_CFG_MAX_OBJECTS" display="Maximum number of stored labels." default="20" type="text"/>
        <property id="RM_SFD_CFG_LABEL_MAX_BYTES" display="Maximum label length in bytes." default="40" type="text"/>
    </configuration>
</module>

