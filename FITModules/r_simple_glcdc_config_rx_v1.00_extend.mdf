<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="XSIZE_PHYS" display="LCD width in pixels" default="480" type="textbox">
            <constraint display="Value must be a positive integer" actionOnFail="error">testInteger("${XSIZE_PHYS}") &amp;&amp; ("${XSIZE_PHYS}" &gt; 0)</constraint>
            <description>Horizontal active pixel width. The RX72N Envision Kit LCD uses 480.</description>
        </property>
        <property id="YSIZE_PHYS" display="LCD height in pixels" default="272" type="textbox">
            <constraint display="Value must be a positive integer" actionOnFail="error">testInteger("${YSIZE_PHYS}") &amp;&amp; ("${YSIZE_PHYS}" &gt; 0)</constraint>
            <description>Vertical active pixel height. The RX72N Envision Kit LCD uses 272.</description>
        </property>
        <property id="XSIZE_OUTOF_DISPLAY" display="Line offset padding in pixels" default="32" type="textbox">
            <constraint display="Value must be a non-negative integer" actionOnFail="error">testInteger("${XSIZE_OUTOF_DISPLAY}") &amp;&amp; ("${XSIZE_OUTOF_DISPLAY}" &gt;= 0)</constraint>
            <description>Additional line offset used by the simple CLUT8 frame buffer layout.</description>
        </property>
        <property id="_BRIGHTNESS" display="LCD brightness setting" default="0x200" type="textbox">
            <description>GLCDC brightness setting value used by the simple configuration helper.</description>
        </property>
        <property id="_CONTRAST" display="LCD contrast setting" default="0x80" type="textbox">
            <description>GLCDC contrast setting value used by the simple configuration helper.</description>
        </property>
    </configuration>
</module>
