    <package>
        <type>fitmodule</type>
        <name>r_simple_glcdc_config_rx</name>
        <version>1.01.saffti-original</version>
        <zipsource>r_simple_glcdc_config_rx_v1.01.saffti-original.zip</zipsource>
        <dependency>
            <module>r_bsp</module>
            <version>7.52</version>
        </dependency>
        <dependency>
            <module>r_glcdc_rx</module>
            <version>1.30</version>
        </dependency>
        <application>Display</application>
        <application>Graphics</application>
        <desc>Simple GLCDC configuration helper for 480x272 RGB565 LCD output on RX.</desc>
        <details>This module wraps r_glcdc_rx setup for a CLUT8 frame buffer on a 480x272 RGB565 LCD panel and exposes R_SIMPLE_GLCDC_CONFIG_Open/Close plus lcd_get_frame_buffer_pointer. The default control pins target the RX65N-RSK-2MB on-board TFT and can be overridden in configuration.</details>
        <incdir>r_config</incdir>
        <incdir>r_simple_glcdc_config_rx</incdir>
        <incdir>r_simple_glcdc_config_rx/src</incdir>
    </package>

</refinfo>
