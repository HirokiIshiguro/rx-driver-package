<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00.saffti-original</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="RM_LITTLEFS_CFG_READ_SIZE" display="Default littlefs read size." default="4" type="text"/>
        <property id="RM_LITTLEFS_CFG_PROG_SIZE" display="Default littlefs program size." default="4" type="text"/>
        <property id="RM_LITTLEFS_CFG_BLOCK_SIZE" display="Default littlefs block size." default="128" type="text"/>
        <property id="RM_LITTLEFS_CFG_CACHE_SIZE" display="Default littlefs cache size." default="64" type="text"/>
        <property id="RM_LITTLEFS_CFG_LOOKAHEAD_SIZE" display="Default littlefs lookahead size." default="16" type="text"/>
        <property id="RM_LITTLEFS_CFG_PROVIDE_ABORT" display="Provide abort() for littlefs assert." default="1" type="combobox">
            <option id="RM_LITTLEFS_CFG_PROVIDE_ABORT.0" display="Disabled" value="0"/>
            <option id="RM_LITTLEFS_CFG_PROVIDE_ABORT.1" display="Enabled" value="1"/>
        </property>
    </configuration>
</module>
