<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="SIMPLE_GRAPHIC_CFG_FONT_WIDTH" display="Font width in pixels" default="6" type="textbox">
            <constraint display="Value must be a positive integer" actionOnFail="error">testInteger("${SIMPLE_GRAPHIC_CFG_FONT_WIDTH}") &amp;&amp; ("${SIMPLE_GRAPHIC_CFG_FONT_WIDTH}" &gt; 0)</constraint>
            <description>Fixed font cell width in pixels.</description>
        </property>
        <property id="SIMPLE_GRAPHIC_CFG_FONT_HEIGHT" display="Font height in pixels" default="8" type="textbox">
            <constraint display="Value must be a positive integer" actionOnFail="error">testInteger("${SIMPLE_GRAPHIC_CFG_FONT_HEIGHT}") &amp;&amp; ("${SIMPLE_GRAPHIC_CFG_FONT_HEIGHT}" &gt; 0)</constraint>
            <description>Fixed font cell height in pixels.</description>
        </property>
        <property id="SIMPLE_GRAPHIC_CFG_REFRESH_FREQUENCY" display="Refresh frequency" default="60" type="textbox">
            <constraint display="Value must be a positive integer" actionOnFail="error">testInteger("${SIMPLE_GRAPHIC_CFG_REFRESH_FREQUENCY}") &amp;&amp; ("${SIMPLE_GRAPHIC_CFG_REFRESH_FREQUENCY}" &gt; 0)</constraint>
            <description>CMT refresh frequency for copying changed text cells into the frame buffer.</description>
        </property>
    </configuration>
</module>
