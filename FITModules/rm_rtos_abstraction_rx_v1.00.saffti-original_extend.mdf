<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00.saffti-original</fileVersion>
    <formatVersion>2.00</formatVersion>
    <fileTemplate></fileTemplate>
    <configuration>
        <property id="RM_RTOS_ABSTRACTION_CFG_PARAM_CHECKING_ENABLE" display="Enable parameter checking." default="1" type="combobox">
            <option id="RM_RTOS_ABSTRACTION_CFG_PARAM_CHECKING_ENABLE.0" display="Disabled" value="0"/>
            <option id="RM_RTOS_ABSTRACTION_CFG_PARAM_CHECKING_ENABLE.1" display="Enabled" value="1"/>
            <description>Set to 1 to include parameter checking code. Set to 0 to compile out parameter checking code.</description>
        </property>
    </configuration>
</module>
